{
  "name": "takedasite",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-10",
  // 武田様の Cloudflare アカウント（T.takeda.tax.office@gmail.com）。
  // 2026-09-08 に菊池さんのアカウントから移管した。
  "account_id": "0e5afad5b6fd94861d5553599330918c",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // 静的アセットも Worker を通す。一般公開しない運用のため、
    // 全レスポンスに X-Robots-Tag: noindex を付ける必要がある（要件定義書 §1）。
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "INQUIRIES", "id": "2dc6663679a443888ab09a0fddc9a636" }
  ],
  "vars": {
    // MICROCMS_SERVICE_DOMAIN はここには置かない。
    // このリポジトリは public なので、APIキーと同じく secret 側に入れてある。
    // microCMS のエンドポイント（APIの識別子）
    "MICROCMS_ENDPOINT": "news",
    // Lark / Feishu のAPIホスト。Lark（国際版）は open.larksuite.com
    "LARK_BASE_HOST": "https://open.larksuite.com"
  }
}

{
  "name": "takedasite",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-10",
  "account_id": "fa03cd9cababb13a09331265a38f4ed1",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // 静的アセットも Worker を通す。一般公開しない運用のため、
    // 全レスポンスに X-Robots-Tag: noindex を付ける必要がある（要件定義書 §1）。
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "INQUIRIES", "id": "686fa302084e4bacaf163180b0433776" }
  ],
  "vars": {
    // microCMS のサービスドメイン（https://<ここ>.microcms.io）。武田様のアカウント開設後に設定する。
    "MICROCMS_SERVICE_DOMAIN": "",
    // microCMS のエンドポイント（APIの識別子）
    "MICROCMS_ENDPOINT": "news",
    // Lark / Feishu のAPIホスト。Lark（国際版）は open.larksuite.com
    "LARK_BASE_HOST": "https://open.larksuite.com"
  }
}
